{
  "rules": {
    ".read": false,
    ".write": false,
    "Image": {
      ".read": "auth.token.email != null && auth.token.email != '' && root.child('Whitelist').child(auth.token.email.replace('.', '_')).exists()",
      ".write": "auth != null"
    },
    "Request": {
      ".write": "auth.token.email != null && auth.token.email != '' && root.child('Whitelist').child(auth.token.email.replace('.', '_')).exists()",
      ".read": "auth != null"
    },
    "DoorState": {
      ".read": "auth.token.email != null && auth.token.email != '' && root.child('Whitelist').child(auth.token.email.replace('.', '_')).exists()",
      ".write": "auth != null"
    },
    "DoorAlert": {
      ".read": "auth.token.email != null && auth.token.email != '' && root.child('Whitelist').child(auth.token.email.replace('.', '_')).exists()",
      ".write": "auth != null"
    },
    "Whitelist": {
      ".write": false,
      ".read": "auth != null"
    }
  }
}
